	"dependencies": {
		"https": "^1.0.0",
		"image-size": "^1.2.1",
		"jszip": "^3.10.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gitbrent/PptxGenJS.git"
	},
	"keywords": [
		"es6-powerpoint",
		"html-to-powerpoint",
		"javascript-create-powerpoint",
		"javascript-create-pptx",
