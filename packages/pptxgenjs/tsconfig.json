{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"lib": [
			"dom",
			"es2020"
		],
		"module": "ES2020",
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"noImplicitAny": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"sourceMap": true,
		"strict": true,
		"strictNullChecks": false,
		"target": "es2016"
	},
	"display": "Recommended",
	"$schema": "https://json.schemastore.org/tsconfig",
	"include": [
		"src/**/*"
	]
}
